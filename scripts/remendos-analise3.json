  {
    "nome": "eventos do dia dentro do cartao do ativo",
    "marca": "EVENTOS DO DIA , o site atual fecha",
    "de": "{{ a.news }}</p></div>\n          </div>\n        </sc-for>",
    "para": "{{ a.news }}</p></div>\n            <!-- EVENTOS DO DIA , o site atual fecha o cartao do ativo com o paragrafo\n                 \"Today's events\" e a caixa vermelha HIGH-IMPACT EVENTS TODAY. O pacote\n                 do Design parava no impacto de noticias. Dado vem do MESMO calendario\n                 que a home ja usa (self.calData), filtrado por hoje. -->\n            <sc-if value=\"{{ a.temEventos }}\" hint-placeholder-val=\"{{ false }}\">\n            <div style=\"padding: 0 22px 16px;\"><p style=\"margin: 0; font-size: 13px; line-height: 1.6; color: #b8c0c8;\"><b style=\"color:#E7ECEF;\">{{ a.rotEventos }}</b> {{ a.eventosTexto }}</p></div>\n            <div style=\"margin: 0 22px 20px; padding: 14px 16px; border-radius: 12px; background: rgba(239,68,68,0.05); border: 1px solid rgba(239,68,68,0.18);\">\n              <div style=\"font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; margin-bottom: 6px; color: #f87171;\">{{ a.rotAlto }}</div>\n              <sc-for list=\"{{ a.eventos }}\" as=\"ev\" hint-placeholder-count=\"3\">\n                <div style=\"display: flex; align-items: center; gap: 10px; padding: 5px 0; font-size: 12.5px;\">\n                  <span style=\"color: #8a94a0; min-width: 62px; font-variant-numeric: tabular-nums;\">{{ ev.hora }}</span>\n                  <span style=\"{{ ev.ccyStyle }}\">{{ ev.ccy }}</span>\n                  <span style=\"color: #d7dde2; font-weight: 600;\">{{ ev.nome }}</span>\n                  <span style=\"margin-left: auto; color: #8a94a0;\">{{ ev.previsao }}</span>\n                </div>\n              </sc-for>\n            </div>\n            </sc-if>\n          </div>\n        </sc-for>"
  },
  {
    "nome": "bolinhas de confianca ao lado do vies",
    "marca": "{{ a.dots }}</span>",
