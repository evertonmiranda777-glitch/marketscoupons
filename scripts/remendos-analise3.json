    "para": "<div style=\"padding: 0 22px 14px; display: flex; align-items: center; gap: 10px;\"><span style=\"{{ a.biasStyle }}\">{{ a.bias }}</span><span style=\"{{ a.dotsStyle }}\">{{ a.dots }}</span></div>"
  }
