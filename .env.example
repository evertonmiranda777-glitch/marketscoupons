# Copie para .env.local e preencha SOMENTE com credenciais de DEV.
# Produção vive nas env vars da Vercel e nos secrets do GitHub.
# Se um valor daqui vazar, não pode abrir nada que esteja no ar.

# Supabase — PROJETO DE DEV (nunca o de produção)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram — BOT DE TESTE (nunca o bot do canal real)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MC_TG_SECRET=

# Vercel — token de escopo mínimo, se precisar de CLI local
VERCEL_TOKEN=
